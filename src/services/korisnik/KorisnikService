import KorisnikServiceLocalStorage from "./KorisnikServiceLocalStorage";
import KorisnikServiceMemorija from "./KorisnikServiceMemorija";
import { DATA_SOURCE } from "../../constants";

let Servis = null;

switch (DATA_SOURCE) {
  case "memorija":
    Servis = KorisnikServiceMemorija;
    break;

  case "localStorage":
    Servis = KorisnikServiceLocalStorage;
    break;

  default:
    Servis = null;
}

const PrazanServis = {
  get: async () => ({ success: false, data: [] }),
  getBySifra: async () => ({ success: false, data: {} }),
  dodaj: async () => console.error("KorisnikService nije učitan"),
  promjeni: async () => console.error("KorisnikService nije učitan"),
  obrisi: async () => console.error("KorisnikService nije učitan"),
};

const AktivniServis = Servis || PrazanServis;

export default {
  get: () => AktivniServis.get(),
  getBySifra: (sifra) => AktivniServis.getBySifra(sifra),
  dodaj: (korisnik) => AktivniServis.dodaj(korisnik),
  promjeni: (sifra, korisnik) => AktivniServis.promjeni(sifra, korisnik),
  obrisi: (sifra) => AktivniServis.obrisi(sifra),
};